# Twitch connection (Outbound TLS, no public IP or domain required)
TWITCH_BOT_USERNAME=
# OAuth token generated with chat:read and chat:edit scopes (e.g. from twitchtokengenerator.com)
TWITCH_OAUTH_TOKEN=oauth:
TWITCH_CHANNEL=
COMMAND_PREFIX=!gpt
RATE_LIMIT_SECONDS=8

# LLM Provider selection: "gemini" or "nvidia" (defaults to "gemini")
LLM_PROVIDER=gemini

# Google Gemini settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=150
GEMINI_TEMPERATURE=0.7

# NVIDIA NIM settings (used only if LLM_PROVIDER=nvidia)
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_MAX_TOKENS=120
NVIDIA_TEMPERATURE=0.7

# System prompt applied to all LLM requests
SYSTEM_PROMPT=You are a helpful Twitch chat assistant. Keep every answer concise, single line, and safe for a public stream.

# Optional health check port for Dokploy (default: 8080)
PORT=8080
